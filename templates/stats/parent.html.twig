{% extends 'base.html.twig' %}

{% block body %}
<h1>{{ 'parent.title'|trans }}</h1>
{% if children %}
    <div class="card">
        <table class="stats">
            <tr><th>{{ 'parent.child'|trans }}</th><th>{{ 'stats.total'|trans }}</th><th>{{ 'stats.result'|trans }}</th><th>{{ 'rank.by_level'|trans }}</th><th></th></tr>
            {% for item in children %}
                <tr>
                    <td><strong>{{ item.user.username }}</strong><br><small class="muted">{{ 'parent.since'|trans }} {{ item.user.createdAt|date('d.m.Y') }}</small></td>
                    <td>{{ item.summary.total }}</td>
                    <td>{% include 'stats/_percent.html.twig' with {row: item.summary} %}</td>
                    <td class="small">{% for n, l in item.progress.levels %}{{ n }}: ⚽ {{ l.rank }} {{ l.player.name }}{% if not l.unlocked %} 🔒{% endif %}<br>{% endfor %}</td>
                    <td><a class="btn" href="{{ path('parent_child', {id: item.user.id}) }}">{{ 'parent.detail'|trans }}</a></td>
                </tr>
            {% endfor %}
        </table>
    </div>
{% else %}
    <p class="muted">{{ 'parent.no_children'|trans }}</p>
{% endif %}

<div class="parent-forms">
    <div class="card">
        <h2>{{ 'parent.add_child'|trans }}</h2>
        <p class="small muted">{{ 'parent.add_child_help'|trans }}</p>
        {{ form_start(add_form, {action: path('parent_add_child')}) }}
            {{ form_row(add_form.username) }}
            {{ form_row(add_form.plainPassword.first) }}
            {{ form_row(add_form.plainPassword.second) }}
            <button class="btn btn-primary" type="submit">{{ 'parent.add_child_submit'|trans }}</button>
        {{ form_end(add_form) }}
    </div>
    <div class="card">
        <h2>{{ 'parent.link_child'|trans }}</h2>
        <p class="small muted">{{ 'parent.link_child_help'|trans }}</p>
        {{ form_start(link_form, {action: path('parent_link_child')}) }}
            {{ form_row(link_form.code) }}
            <button class="btn btn-primary" type="submit">{{ 'parent.link_child_submit'|trans }}</button>
        {{ form_end(link_form) }}
    </div>
</div>
{% endblock %}
