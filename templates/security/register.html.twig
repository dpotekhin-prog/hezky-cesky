{% extends 'base.html.twig' %}

{% block title %}{{ 'register.title'|trans }}{% endblock %}

{% block body %}
<div class="card narrow">
    <h1>{{ 'register.title'|trans }}</h1>
    {{ form_start(form) }}
        {{ form_row(form.username) }}
        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}
        <button class="btn btn-primary" type="submit">{{ 'register.submit'|trans }}</button>
    {{ form_end(form) }}
    <p class="muted">{{ 'register.have_account'|trans }} <a href="{{ path('app_login') }}">{{ 'login.title'|trans }}</a></p>
</div>
{% endblock %}
