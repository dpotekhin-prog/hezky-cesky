{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block body %}
<div class="card narrow">
    <h1>{{ 'login.title'|trans }}</h1>
    {% if error %}
        <div class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    <form method="post">
        <label for="username">{{ 'form.username'|trans }}</label>
        <input type="text" value="{{ last_username }}" name="_username" id="username" autocomplete="username" required autofocus>
        <label for="password">{{ 'form.password'|trans }}</label>
        <input type="password" name="_password" id="password" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn btn-primary" type="submit">{{ 'login.submit'|trans }}</button>
    </form>
    <p class="muted">{{ 'login.no_account'|trans }} <a href="{{ path('app_register') }}">{{ 'register.title'|trans }}</a></p>
    <p class="muted small"><a href="{{ path('app_help') }}">{{ 'login.how_it_works'|trans }}</a></p>
</div>
{% endblock %}
